# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Configuration
# MONGODB_URI=mongodb://localhost:27017/luvana-paris
MONGODB_URI='mongodb+srv://hrithikelayur12_db_user:iRIFZyWr6uZEE5k9@luana-paris.ei5r1tm.mongodb.net/luvana-paris'

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Secret — ROTATE THIS VALUE before next deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET='this_luvana756#'
TAP_SECRET_KEY='sk_test_XKokBfNWv6FIYuTMg5sLPjhJ'

# Session secret — REQUIRED in production; must be a strong random value
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# MyFatoorah Payment Configuration
MYFATOORAH_ENV=sandbox
MYFATOORAH_API_TOKEN=SK_KWT_vVZlnnAqu8jRByOWaRPNId4ShzEDNt256dvnjebuyzo52dXjAfRx2ixW5umjWSUx
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# Webhook V2 secret — set this from the merchant portal (Integration → Webhooks)
# Without it, IPN signature verification is disabled and webhooks will be rejected.
MYFATOORAH_WEBHOOK_SECRET=

# Active payment provider: 'tap' (production) or 'myfatoorah' (sandbox testing)
# The backend uses this to decide which API to call for verification.
PAYMENT_PROVIDER=myfatoorah

# Supported currencies
MYFATOORAH_SUPPORTED_CURRENCIES=KWD,SAR,AED

# CORS allowed origins (comma-separated). Required in production.
# Example: CORS_ORIGIN=https://luvanaparis.com,https://www.luvanaparis.com
CORS_ORIGIN=http://localhost:4000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME='df0jugmxr'
CLOUDINARY_API_KEY='876349442238177'
CLOUDINARY_API_SECRET='VIevf7rpePqh1deA1lZroa0xntI'